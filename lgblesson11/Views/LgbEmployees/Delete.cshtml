@model Lgb2410900009_exam.Models.LgbEmployee

@{
    ViewData["Title"] = "Xóa Nhân Viên";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-danger text-white py-3">
                    <h4 class="card-title mb-0 fw-bold">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>XÁC NHẬN XÓA NHÂN VIÊN
                    </h4>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning border-start border-warning border-4" role="alert">
                        <strong>Cảnh báo!</strong> Bạn có chắc chắn muốn xóa nhân viên <strong>@Model.LgbName</strong> không? Thao tác này không thể hoàn tác.
                    </div>

                    <dl class="row fs-6 mb-0">
                        <dt class="col-sm-4 text-muted py-2">Mã Nhân Viên:</dt>
                        <dd class="col-sm-8 fw-bold py-2">#@Model.Id</dd>

                        <dt class="col-sm-4 text-muted py-2">Họ và Tên:</dt>
                        <dd class="col-sm-8 fw-bold text-danger py-2">@Model.LgbName</dd>

                        <dt class="col-sm-4 text-muted py-2">Giới Tính:</dt>
                        <dd class="col-sm-8 py-2">@Model.LgbGender</dd>

                        <dt class="col-sm-4 text-muted py-2">Ngày Sinh:</dt>
                        <dd class="col-sm-8 py-2">@(Model.LgbBirthDay.HasValue ? Model.LgbBirthDay.Value.ToString("dd/MM/yyyy") : "-")</dd>

                        <dt class="col-sm-4 text-muted py-2">Email:</dt>
                        <dd class="col-sm-8 py-2">@Model.LgbEmail</dd>

                        <dt class="col-sm-4 text-muted py-2">Số Điện Thoại:</dt>
                        <dd class="col-sm-8 py-2">@Model.LgbPhone</dd>
                    </dl>

                    <form asp-action="Delete" class="mt-4">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                                <i class="bi bi-arrow-left me-1"></i> Hủy Bỏ
                            </a>
                            <button type="submit" class="btn btn-danger rounded-pill px-4">
                                <i class="bi bi-trash-fill me-1"></i> Xác Nhận Xóa
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
