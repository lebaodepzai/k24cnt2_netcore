@{
    ViewData["Title"] = "Thông Tin Sinh Viên";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header text-white text-center py-4" style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);">
                    <div class="mb-3">
                        <span class="d-inline-flex align-items-center justify-content-center bg-white text-primary rounded-circle shadow" style="width: 90px; height: 90px; font-size: 2.5rem; font-weight: bold;">
                            LGB
                        </span>
                    </div>
                    <h3 class="card-title fw-bold mb-1">TRANG THÔNG TIN SINH VIÊN</h3>
                    <p class="mb-0 opacity-75">Bài Thi KTHP - ASP.NET Core MVC</p>
                </div>

                <div class="card-body p-4 p-md-5 bg-light">
                    <div class="list-group list-group-flush rounded-3 shadow-sm bg-white">
                        <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-secondary fw-semibold">
                                <i class="bi bi-person-badge text-primary me-2"></i>Mã Sinh Viên:
                            </span>
                            <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill">@ViewBag.StudentId</span>
                        </div>

                        <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-secondary fw-semibold">
                                <i class="bi bi-person text-primary me-2"></i>Họ và Tên:
                            </span>
                            <span class="fw-bold fs-5 text-dark">@ViewBag.StudentName (lgb)</span>
                        </div>

                        <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-secondary fw-semibold">
                                <i class="bi bi-mortarboard text-primary me-2"></i>Lớp Học:
                            </span>
                            <span class="fw-semibold text-secondary">@ViewBag.Class</span>
                        </div>

                        <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-secondary fw-semibold">
                                <i class="bi bi-envelope text-primary me-2"></i>Email Sinh Viên:
                            </span>
                            <span class="text-dark">@ViewBag.Email</span>
                        </div>

                        <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-secondary fw-semibold">
                                <i class="bi bi-telephone text-primary me-2"></i>Số Điện Thoại:
                            </span>
                            <span class="text-dark">@ViewBag.Phone</span>
                        </div>

                        <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-secondary fw-semibold">
                                <i class="bi bi-book text-primary me-2"></i>Học Phần:
                            </span>
                            <span class="fw-semibold text-success">@ViewBag.Course</span>
                        </div>

                        <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-secondary fw-semibold">
                                <i class="bi bi-building text-primary me-2"></i>Trường / Viện:
                            </span>
                            <span class="text-dark">@ViewBag.School</span>
                        </div>
                    </div>

                    <div class="mt-4 text-center">
                        <a asp-controller="LgbStudents" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-4 me-2 shadow-sm">
                            <i class="bi bi-people me-1"></i> Quản Lý Sinh Viên
                        </a>
                        <a asp-controller="LgbEmployees" asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill px-4 shadow-sm">
                            <i class="bi bi-person-workspace me-1"></i> Quản Lý Nhân Viên
                        </a>
                    </div>
                </div>

                <div class="card-footer bg-white text-center py-3 text-muted small">
                    Dự án bài thi ASP.NET Core MVC &bull; Mã SV: 2410900009
                </div>
            </div>
        </div>
    </div>
</div>
