@{
    ViewData["Title"] = "Trang Chủ";
}

<div class="py-4">
    <div class="p-5 mb-4 bg-primary text-white rounded-4 shadow-lg position-relative overflow-hidden" style="background: linear-gradient(135deg, #0d6efd 0%, #084298 100%);">
        <div class="container-fluid py-3 position-relative z-1">
            <h1 class="display-4 fw-bold mb-3">DỰ ÁN BÀI THI ASP.NET CORE MVC</h1>
            <p class="col-md-9 fs-5 text-light opacity-90 mb-4">
                Hệ thống quản lý Sinh viên & Nhân viên kết nối cơ sở dữ liệu Microsoft SQL Server (EF Core).
                Được thực hiện bởi sinh viên: <strong>Lê Gia Bảo (lgb)</strong> - Mã SV: <strong>2410900009</strong>.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Home" asp-action="LgbAbout" class="btn btn-light btn-lg px-4 rounded-pill fw-bold text-primary shadow-sm">
                    <i class="bi bi-person-badge-fill me-2"></i> Trang Thông Tin Sinh Viên
                </a>
                <a asp-controller="LgbStudents" asp-action="Index" class="btn btn-outline-light btn-lg px-4 rounded-pill shadow-sm">
                    <i class="bi bi-people-fill me-2"></i> Danh Sách Sinh Viên
                </a>
                <a asp-controller="LgbEmployees" asp-action="Index" class="btn btn-warning btn-lg px-4 rounded-pill fw-bold text-dark shadow-sm">
                    <i class="bi bi-person-workspace me-2"></i> Danh Sách Nhân Viên
                </a>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-2">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-3 text-center">
                <div class="card-body d-flex flex-column align-items-center justify-content-between">
                    <div class="d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-circle mb-3" style="width: 70px; height: 70px;">
                        <i class="bi bi-person-lines-fill fs-2"></i>
                    </div>
                    <h4 class="card-title fw-bold mb-3">Thông Tin Sinh Viên</h4>
                    <a asp-controller="Home" asp-action="LgbAbout" class="btn btn-outline-primary rounded-pill w-100 mt-2">
                        Xem Chi Tiết <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-3 text-center">
                <div class="card-body d-flex flex-column align-items-center justify-content-between">
                    <div class="d-inline-flex align-items-center justify-content-center bg-success-subtle text-success rounded-circle mb-3" style="width: 70px; height: 70px;">
                        <i class="bi bi-people-fill fs-2"></i>
                    </div>
                    <h4 class="card-title fw-bold mb-3">Quản Lý Sinh Viên</h4>
                    <a asp-controller="LgbStudents" asp-action="Index" class="btn btn-outline-success rounded-pill w-100 mt-2">
                        Quản Lý Sinh Viên <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-3 text-center">
                <div class="card-body d-flex flex-column align-items-center justify-content-between">
                    <div class="d-inline-flex align-items-center justify-content-center bg-warning-subtle text-warning-emphasis rounded-circle mb-3" style="width: 70px; height: 70px;">
                        <i class="bi bi-database-fill-gear fs-2"></i>
                    </div>
                    <h4 class="card-title fw-bold mb-3">Quản Lý Nhân Viên</h4>
                    <a asp-controller="LgbEmployees" asp-action="Index" class="btn btn-outline-warning rounded-pill text-dark w-100 mt-2">
                        Quản Lý Nhân Viên <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
