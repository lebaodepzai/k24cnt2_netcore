<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lgb2410900009_exam</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Lgb2410900009_exam.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm py-3">
            <div class="container">
                <a class="navbar-brand fw-bold fs-4 d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-code-square me-2 fs-3"></i> Lgb2410900009_exam
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link fw-semibold px-3" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Trang Chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold px-3" asp-area="" asp-controller="Home" asp-action="LgbAbout">
                                <i class="bi bi-person-lines-fill me-1"></i> Thông Tin Sinh Viên
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold px-3" asp-area="" asp-controller="LgbStudents" asp-action="Index">
                                <i class="bi bi-people me-1"></i> Danh Sách Sinh Viên
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold px-3" asp-area="" asp-controller="LgbEmployees" asp-action="Index">
                                <i class="bi bi-person-workspace me-1"></i> Danh Sách Nhân Viên
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center text-white">
                        <span class="badge bg-white text-primary rounded-pill px-3 py-2 fw-bold shadow-sm">
                            <i class="bi bi-person-circle me-1"></i> lgb - 2410900009
                        </span>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1 my-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer mt-auto py-3 bg-dark text-white-50 border-top">
        <div class="container text-center">
            <div class="row align-items-center">
                <div class="col-md-6 text-md-start mb-2 mb-md-0">
                    <span class="fw-semibold text-white">&copy; 2026 - Lgb2410900009_exam</span> &bull; K24CNT2 .NET Core MVC
                </div>
                <div class="col-md-6 text-md-end">
                    <span class="text-light me-3"><i class="bi bi-person-badge"></i> SV: Lê Gia Bảo (lgb)</span>
                    <span class="badge bg-secondary">MSV: 2410900009</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
