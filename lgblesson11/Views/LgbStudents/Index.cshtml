@model IEnumerable<Lgb2410900009_exam.Models.LgbStudent>

@{
    ViewData["Title"] = "Danh Sách Sinh Viên";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-primary fw-bold mb-1">
                <i class="bi bi-people-fill me-2"></i>DANH SÁCH SINH VIÊN
            </h2>
            <p class="text-muted mb-0">Quản lý thông tin sinh viên bảng <code>LgbStudent</code> (Mã SV: 2410900009)</p>
        </div>
        <a asp-action="Create" class="btn btn-success btn-lg rounded-pill shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Thêm Sinh Viên Mới
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Tìm kiếm theo tên, email, sdt..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="genderFilter" class="form-select">
                        <option value="">-- Tất cả giới tính --</option>
                        <option value="Nam" selected="@(ViewBag.GenderFilter == "Nam")">Nam</option>
                        <option value="Nữ" selected="@(ViewBag.GenderFilter == "Nữ")">Nữ</option>
                    </select>
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary">Tìm kiếm</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark text-uppercase small">
                    <tr>
                        <th class="ps-4">@Html.DisplayNameFor(model => model.Id)</th>
                        <th>@Html.DisplayNameFor(model => model.LgbName)</th>
                        <th>@Html.DisplayNameFor(model => model.LgbGender)</th>
                        <th>@Html.DisplayNameFor(model => model.LgbBirthDay)</th>
                        <th>@Html.DisplayNameFor(model => model.LgbEmail)</th>
                        <th>@Html.DisplayNameFor(model => model.LgbPhone)</th>
                        <th>@Html.DisplayNameFor(model => model.LgbAddress)</th>
                        <th class="text-center">@Html.DisplayNameFor(model => model.LgbActive)</th>
                        <th class="text-center pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                Không tìm thấy dữ liệu sinh viên nào!
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-secondary">#@item.Id</td>
                                <td>
                                    <div class="fw-bold text-dark">@item.LgbName</div>
                                </td>
                                <td>
                                    @if (item.LgbGender == "Nam")
                                    {
                                        <span class="badge bg-info text-dark rounded-pill">Nam</span>
                                    }
                                    else if (item.LgbGender == "Nữ")
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill">Nữ</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark">@item.LgbGender</span>
                                    }
                                </td>
                                <td>@(item.LgbBirthDay.HasValue ? item.LgbBirthDay.Value.ToString("dd/MM/yyyy") : "-")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.LgbEmail))
                                    {
                                        <a href="mailto:@item.LgbEmail" class="text-decoration-none">@item.LgbEmail</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@item.LgbPhone</td>
                                <td>@item.LgbAddress</td>
                                <td class="text-center">
                                    @if (item.LgbActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success rounded-pill px-3 py-1">Đang học</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary rounded-pill px-3 py-1">Nghỉ học</span>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning" title="Chỉnh sửa">
                                            <i class="bi bi-pencil-square"></i> Sửa
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Chi tiết">
                                            <i class="bi bi-eye"></i> Xem
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Xóa">
                                            <i class="bi bi-trash"></i> Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
