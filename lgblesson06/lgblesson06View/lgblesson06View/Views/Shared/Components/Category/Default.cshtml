@model IEnumerable<lgblesson06View.Models.Category>;

<div class="bg-danger">
    <ul class="list-group">
        <li class="list-group-item active" aria-current>DANH MỤC</li>
        @foreach (var item in Model)
        {
            <li class="list-group-item">
                <a href="#">@item.CategoryName</a>
            </li>
        }
    </ul>
        
</div>