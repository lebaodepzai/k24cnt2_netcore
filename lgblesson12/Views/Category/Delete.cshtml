@model lgblesson12.Models.Category

@{
    ViewData["Title"] = "Xóa danh mục";
}

<h2>Xóa danh mục</h2>

<h3>Bạn có chắc chắn muốn xóa danh mục này?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
        <dd class = "col-sm-9">@Html.DisplayFor(model => model.Name)</dd>

        <dt class = "col-sm-3">@Html.DisplayNameFor(model => model.Status)</dt>
        <dd class = "col-sm-9">@(Model.Status == 1 ? "Hiển thị" : "Ẩn")</dd>

        <dt class = "col-sm-3">@Html.DisplayNameFor(model => model.CreatedDate)</dt>
        <dd class = "col-sm-9">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm:ss")</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Xóa" class="btn btn-sm btn-danger" /> |
        <a class="btn btn-sm btn-secondary" asp-action="Index">Back to List</a>
    </form>
</div>
