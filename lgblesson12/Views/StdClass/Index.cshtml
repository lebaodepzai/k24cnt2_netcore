@model IEnumerable<lgblesson12.Models.StdClass>

@{
    ViewData["Title"] = "Danh sách lớp học";
}

<h2>Danh sách Lớp Học (StdClass)</h2>

<p>
    <a class="btn btn-sm btn-success" asp-action="Create"><i class="bi bi-plus-circle"></i> Thêm mới lớp học</a>
</p>

<table class="table table-bordered table-striped align-middle">
    <thead class="table-dark">
        <tr>
            <th>Mã lớp</th>
            <th>Tên lớp học</th>
            <th class="text-center">Thao tác</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Id</td>
            <td>@item.ClassName</td>
            <td class="text-center">
                <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a class="btn btn-sm btn-success" asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
