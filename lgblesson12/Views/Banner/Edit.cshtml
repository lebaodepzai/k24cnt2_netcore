@model lgblesson12.Models.Banner

@{
    ViewData["Title"] = "Chỉnh sửa Banner";
}

<h2>Chỉnh sửa Banner</h2>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Image" />
            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label fw-bold"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label class="control-label fw-bold">Ảnh hiện tại</label>
                <div>
                    @if (!string.IsNullOrEmpty(Model.Image)) {
                        <img src="~/Banner/@Model.Image" alt="@Model.Name" style="width: 150px;" class="img-thumbnail mb-2" />
                    } else {
                        <span class="text-muted d-block mb-2">Chưa có ảnh</span>
                    }
                </div>
                <label class="control-label fw-bold">Chọn ảnh mới (nếu thay đổi)</label>
                <input type="file" name="Image" class="form-control" accept="image/*" />
            </div>
            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label fw-bold"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Status" class="control-label fw-bold"></label>
                <select asp-for="Status" class="form-select">
                    <option value="1">Hiển thị (1)</option>
                    <option value="0">Ẩn (0)</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <input type="submit" value="Lưu thay đổi" class="btn btn-sm btn-success" />
                <a class="btn btn-sm btn-secondary" asp-action="Index">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
