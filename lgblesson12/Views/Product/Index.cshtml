@model IEnumerable<lgblesson12.Models.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<h2>Danh sách sản phẩm</h2>

<p>
    <a class="btn btn-sm btn-success" asp-action="Create"><i class="bi bi-plus-circle"></i> Thêm mới</a>
</p>

<table class="table table-bordered table-striped align-middle">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Image</th>
            <th>Price</th>
            <th>SalePrice</th>
            <th>Status</th>
            <th>Descriptions</th>
            <th>CreatedDate</th>
            <th>Category</th>
            <th class="text-center">Thao tác</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Name)</td>
            <td>
                @if (!string.IsNullOrEmpty(item.Image)) {
                    <img src="~/Product/@item.Image" alt="@item.Name" style="width: 80px; height: 60px; object-fit: cover;" class="img-thumbnail" />
                } else {
                    <span class="text-muted">Không có ảnh</span>
                }
            </td>
            <td>@item.Price.ToString("N0") đ</td>
            <td>@item.SalePrice.ToString("N0") đ</td>
            <td>
                @if (item.Status == 1) {
                    <span class="badge bg-success">1</span>
                } else {
                    <span class="badge bg-secondary">0</span>
                }
            </td>
            <td>@item.Descriptions</td>
            <td>@item.CreatedDate.ToString("dd/MM/yyyy hh:mm:ss tt")</td>
            <td>@item.Category?.Name</td>
            <td class="text-center">
                <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a class="btn btn-sm btn-success" asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
