@{
    ViewData["Title"] = "Danh sách tài khoản";
    var lgbAccounts = ViewBag.lgbAccounts;
}

<div class="row">
    @foreach (lgbAccount item in lgbAccounts)
    {
        <div class="col-md-4 my-3">
            <div class="card">
                <div class="card-body">
                    <div class="img">
                        <img src="@item.Avatar" alt="@item.Name" class="w-100" />
                    </div>
                    <div class="">
                        <h3>@item.Name</h3>
                        <p>@item.Bio</p>
                        <a href="#" class="btn btn-success btn-block">Profile</a>
                    </div>
                </div>
            </div>
        </div>
    }
    
</div>
