@model IEnumerable<LgbLesson10EFDbFirst.Models.LgbMember>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.LgbUserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LgbPassword)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LgbFullName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LgbEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LgbPhone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LgbStatus)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.LgbUserName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LgbPassword)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LgbFullName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LgbEmail)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LgbPhone)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LgbStatus)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
