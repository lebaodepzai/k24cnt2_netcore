
@{
    ViewData["Title"] = "Danh sách sản phẩm";

    var product = ViewData["product"] as List<lgbLesson03.Models.lgbProduct>;
}
<div class="card">
    <div class="card-header">
        <h1>@ViewData["Title"]</h1>
    </div>
    <div class="card-body">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Year</th>
                    <th>Price</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in product)
                {
                    <tr>
                        <td>@item.lgbProductId</td>
                        <td>@item.lgbProductName</td>
                        <td>@item.lgbYearRelease</td>
                        <td>@item.lgbPrice</td>
                        <td>
                            <a href="#" class="btn btn-info">Xem chi tiết</a>
                            <a href="#" class="btn btn-primary">Sửa</a>
                            <a href="#" class="btn btn-danger">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="5">Tổng sản phẩm: @product.Count</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
