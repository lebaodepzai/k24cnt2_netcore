@model lgblesson09Annotation.Models.LgbAccount

@{
    ViewData["Title"] = "Đăng Ký Tài Khoản (Model Validation)";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow border-0">
            <div class="card-header bg-primary text-white py-3">
                <h3 class="card-title mb-0 fs-4">
                    <i class="bi bi-shield-lock-fill me-2"></i>Đăng Ký Tài Khoản - Data Annotations Validation
                </h3>
            </div>
            <div class="card-body p-4">
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label font-weight-bold"></label>
                            <input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên..." />
                            <span asp-validation-for="FullName" class="text-danger fs-7"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label font-weight-bold"></label>
                            <input asp-for="Email" class="form-control" placeholder="example@domain.com" />
                            <span asp-validation-for="Email" class="text-danger fs-7"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label font-weight-bold"></label>
                            <input asp-for="Phone" class="form-control" placeholder="Ví dụ: 0987654321" />
                            <span asp-validation-for="Phone" class="text-danger fs-7"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Age" class="form-label font-weight-bold"></label>
                            <input asp-for="Age" class="form-control" type="number" placeholder="Từ 18 đến 65" />
                            <span asp-validation-for="Age" class="text-danger fs-7"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label font-weight-bold"></label>
                            <input asp-for="Password" class="form-control" placeholder="Tối thiểu 6 ký tự..." />
                            <span asp-validation-for="Password" class="text-danger fs-7"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label font-weight-bold"></label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu..." />
                            <span asp-validation-for="ConfirmPassword" class="text-danger fs-7"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="BirthDate" class="form-label font-weight-bold"></label>
                            <input asp-for="BirthDate" class="form-control" type="date" />
                            <span asp-validation-for="BirthDate" class="text-danger fs-7"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label font-weight-bold">Giới tính</label>
                            <div class="mt-2">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" asp-for="Gender" value="Nam" id="genderNam" checked />
                                    <label class="form-check-label" for="genderNam">Nam</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" asp-for="Gender" value="Nữ" id="genderNu" />
                                    <label class="form-check-label" for="genderNu">Nữ</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FacebookUrl" class="form-label font-weight-bold"></label>
                        <input asp-for="FacebookUrl" class="form-control" placeholder="https://facebook.com/username" />
                        <span asp-validation-for="FacebookUrl" class="text-danger fs-7"></span>
                    </div>

                    <div class="mb-4 form-check">
                        <input class="form-check-input" asp-for="IsActive" id="isActiveCheck" />
                        <label class="form-check-label" for="isActiveCheck">
                            Kích hoạt tài khoản ngay lập tức
                        </label>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-circle-fill me-1"></i> Đăng Ký
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
