@model LgbLesson08Models.Models.LgbMember

@{
    ViewData["Title"] = "Chỉnh sửa thông tin thành viên";
}

<div class="card shadow-sm mt-4">
    <div class="card-header bg-warning text-dark">
        <h3 class="mb-0">@ViewData["Title"]</h3>
    </div>
    
    <div class="card-body">
        <form asp-action="LgbEdit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="LgbMemberId" class="form-label font-weight-bold"></label>
                <input asp-for="LgbMemberId" class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="LgbUserName" class="form-label font-weight-bold"></label>
                <input asp-for="LgbUserName" class="form-control" />
                <span asp-validation-for="LgbUserName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LgbPassword" class="form-label font-weight-bold"></label>
                <input asp-for="LgbPassword" type="password" class="form-control" />
                <span asp-validation-for="LgbPassword" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LgbFullName" class="form-label font-weight-bold"></label>
                <input asp-for="LgbFullName" class="form-control" />
                <span asp-validation-for="LgbFullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LgbEmail" class="form-label font-weight-bold"></label>
                <input asp-for="LgbEmail" type="email" class="form-control" />
                <span asp-validation-for="LgbEmail" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LgbAge" class="form-label font-weight-bold"></label>
                <input asp-for="LgbAge" type="number" class="form-control" />
                <span asp-validation-for="LgbAge" class="text-danger"></span>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-warning me-2">Cập nhật</button>
                <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
