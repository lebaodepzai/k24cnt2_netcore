@model IEnumerable<LgbLesson08Models.Models.LgbMember>

@{
    ViewData["Title"] = "Danh sách thành viên";
}

<div class="card shadow-sm mt-4">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h3 class="mb-0">@ViewData["Title"]</h3>
        <a asp-action="LgbCreate" class="btn btn-light text-primary font-weight-bold">+ Thêm mới thành viên</a>
    </div>

    <div class="card-body">
        <table class="table table-striped table-hover table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.LgbMemberId)</th>
                    <th>@Html.DisplayNameFor(model => model.LgbUserName)</th>
                    <th>@Html.DisplayNameFor(model => model.LgbFullName)</th>
                    <th>@Html.DisplayNameFor(model => model.LgbEmail)</th>
                    <th>@Html.DisplayNameFor(model => model.LgbAge)</th>
                    <th class="text-center" style="width: 220px;">Chức năng</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.LgbMemberId)</td>
                            <td>@Html.DisplayFor(modelItem => item.LgbUserName)</td>
                            <td>@Html.DisplayFor(modelItem => item.LgbFullName)</td>
                            <td>@Html.DisplayFor(modelItem => item.LgbEmail)</td>
                            <td>@Html.DisplayFor(modelItem => item.LgbAge)</td>
                            <td class="text-center">
                                <a asp-action="LgbEdit" asp-route-id="@item.LgbMemberId" class="btn btn-sm btn-warning me-1">Sửa</a>
                                <a asp-action="LgbDetails" asp-route-id="@item.LgbMemberId" class="btn btn-sm btn-info text-white me-1">Chi tiết</a>
                                <a asp-action="LgbDelete" asp-route-id="@item.LgbMemberId" class="btn btn-sm btn-danger">Xóa</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">Chưa có thành viên nào trong danh sách.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
