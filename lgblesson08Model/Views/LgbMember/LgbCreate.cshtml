@model LgbLesson08Models.Models.LgbMember

@{
    ViewData["Title"] = "Thêm mới thành viên";
}

<div class="card shadow-sm mt-4">
    <div class="card-header bg-success text-white">
        <h3 class="mb-0">@ViewData["Title"]</h3>
    </div>
    
    <div class="card-body">
        <form asp-action="LgbCreate" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="LgbMemberId" class="form-label font-weight-bold"></label>
                <input asp-for="LgbMemberId" class="form-control" placeholder="Nhập mã thành viên" />
                <span asp-validation-for="LgbMemberId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LgbUserName" class="form-label font-weight-bold"></label>
                <input asp-for="LgbUserName" class="form-control" placeholder="Nhập tên đăng nhập" />
                <span asp-validation-for="LgbUserName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LgbPassword" class="form-label font-weight-bold"></label>
                <input asp-for="LgbPassword" type="password" class="form-control" placeholder="Nhập mật khẩu" />
                <span asp-validation-for="LgbPassword" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LgbFullName" class="form-label font-weight-bold"></label>
                <input asp-for="LgbFullName" class="form-control" placeholder="Nhập họ và tên" />
                <span asp-validation-for="LgbFullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LgbEmail" class="form-label font-weight-bold"></label>
                <input asp-for="LgbEmail" type="email" class="form-control" placeholder="Nhập địa chỉ email" />
                <span asp-validation-for="LgbEmail" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LgbAge" class="form-label font-weight-bold"></label>
                <input asp-for="LgbAge" type="number" class="form-control" placeholder="Nhập tuổi" />
                <span asp-validation-for="LgbAge" class="text-danger"></span>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-success me-2">Lưu thông tin</button>
                <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
